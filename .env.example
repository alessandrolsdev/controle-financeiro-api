# Arquivo: .env.example
# Copie para .env e preencha. NUNCA versione o .env.

# --- Ambiente ---
# development | staging | production
# Em production as validações são mais rígidas: DATABASE_URL e CORS_ORIGINS
# passam a ser obrigatórios e curingas de CORS são recusados.
ENVIRONMENT=development

# --- Segurança (OBRIGATÓRIO) ---
# Gere uma chave nova e exclusiva por ambiente:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
#
# A aplicação recusa iniciar com chave curta, de baixa entropia, com valores
# placeholder, ou com a chave de exemplo da documentação do FastAPI — que
# esteve publicada no README deste repositório e portanto é pública.
SECRET_KEY=

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
JWT_ISSUER=nomad-controle-financeiro
JWT_AUDIENCE=nomad-app

# Chave dedicada à criptografia de dados pessoais em repouso (nome, e-mail,
# observações e segredo do segundo fator). OBRIGATÓRIA em produção e precisa
# ser DIFERENTE da SECRET_KEY: separá-las permite rotacionar a assinatura de
# tokens sem tornar ilegíveis os dados já gravados.
# Gere com o mesmo comando da SECRET_KEY.
#
# ATENÇÃO: perder esta chave torna os dados cifrados irrecuperáveis. Guarde-a
# no cofre de segredos do provedor, não apenas na variável de ambiente.
ENCRYPTION_KEY=

# --- Cookies de sessão ---
# Os tokens trafegam em cookies httpOnly, fora do alcance de JavaScript.
# 'strict' é o recomendado; 'none' é recusado por desativar a proteção
# nativa contra CSRF.
COOKIE_SAMESITE=strict
# Deixe vazio para restringir o cookie ao host da API (mais seguro).
COOKIE_DOMAIN=

# --- Banco de Dados ---
# Obrigatório em produção; deve ser PostgreSQL.
# Ex.: postgresql://usuario:senha@host:5432/banco
# Em desenvolvimento, se ficar vazio, um SQLite local é usado.
DATABASE_URL=

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800

# --- CORS ---
# Allowlist explícita das origens do frontend, separadas por vírgula.
# Curingas (ex.: https://*.vercel.app) são REJEITADOS em produção: com
# credenciais habilitadas, qualquer pessoa poderia publicar um site sob aquele
# domínio e ler os dados do usuário autenticado.
CORS_ORIGINS=http://localhost:5173

# --- Hosts confiáveis ---
# Allowlist de cabeçalhos Host aceitos. Obrigatório ser explícito em produção.
TRUSTED_HOSTS=*

# --- Rate limiting ---
RATE_LIMIT_LOGIN=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300
RATE_LIMIT_SIGNUP=5
RATE_LIMIT_SIGNUP_WINDOW_SECONDS=3600
RATE_LIMIT_MFA=5
RATE_LIMIT_MFA_WINDOW_SECONDS=300
# Necessário quando há mais de um processo/instância: sem Redis o limite é
# aplicado por processo, e o total efetivo vira (limite x nº de workers).
# Em produção, a aplicação RECUSA iniciar com WEB_CONCURRENCY > 1 e sem Redis.
REDIS_URL=

# Número de processos servindo a aplicação (workers do gunicorn).
WEB_CONCURRENCY=1

# --- Observabilidade ---
LOG_LEVEL=INFO

# --- Superfície exposta ---
# Desative a documentação interativa em produção.
DOCS_ENABLED=true
MAX_REQUEST_BODY_BYTES=1048576
