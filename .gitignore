# Arquivo: .gitignore

# Ambiente virtual. Cada desenvolvedor cria o seu.
venv/
.venv/
env/

# Cache do Python.
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.xml

# Banco de dados local. Nunca enviamos dados para o repositório.
*.db
*.db-journal*
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Arquivos de configuração de IDEs.
.vscode/
.idea/
# Artefatos do Visual Studio: contêm caminhos locais, estado de sessão e um
# índice SQLite do conteúdo dos arquivos — nada disso pertence ao repositório.
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates

# Arquivos de ambiente. NUNCA versione segredos.
.env
.env.*
!.env.example

frontend/.env
frontend/.env.*
!frontend/.env.example

# Artefatos de build do frontend.
node_modules/
dist/
dist-ssr/
*.local

# Sistema operacional.
.DS_Store
Thumbs.db

# Relatórios de ferramentas de segurança.
bandit-report.json
pip-audit-report.json
